@page "/stats"
@rendermode InteractiveServer
@using SamwiseBlazor.DatabaseModels
@using SamwiseBlazor.Dtos
@using SamwiseBlazor.Services
@implements IDisposable
@inject IJSRuntime JS
@inject ISensorDataService SensorDataService
@inject IAlertService AlertService

<PageTitle>Garden Stats</PageTitle>

<div class="container">
    <div class="row">
        <div class="col-md-12">
            <h1>Garden Stats</h1>
            <p>This page displays the garden statistics.</p>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 input-group mb-3">
            <span class="input-group-text">Show</span>
            <select class="form-select" id="dateRange" @bind="SelectedDaysBack">
                <option value="1">Last 24 Hours</option>
                <option value="7">Last 7 Days</option>
                <option value="30">Last 30 Days</option>
            </select>
            <button class="btn btn-outline-warning" type="button" data-bs-toggle="offcanvas" data-bs-target="#alertsOffcanvas" aria-controls="alertsOffcanvas">
                <span class="bi bi-bell me-1" aria-hidden="true"></span><span class="badge bg-warning text-dark position-absolute top-0 start-100 translate-middle">@alerts?.Count</span> Alerts
            </button>
        </div>
    </div>
    <div class="offcanvas offcanvas-end" tabindex="-1" id="alertsOffcanvas" aria-labelledby="alertsOffcanvasLabel">
        <div class="offcanvas-header">
            <h5 class="offcanvas-title" id="alertsOffcanvasLabel">Active alerts</h5>
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
        </div>
        <div class="offcanvas-body">
            @if (alerts == null)
            {
                <p class="text-muted">Loading alerts...</p>
            }
            else if (!alerts.Any())
            {
                <p class="text-muted">No active alerts.</p>
            }
            else
            {
                @foreach (var alert in alerts)
                {
                    <div class="alert alert-warning" role="alert">
                        <h6 class="alert-heading">@(string.IsNullOrWhiteSpace(alert.SensorDescription) ? $"Sensor {alert.SensorId}" : alert.SensorDescription)</h6>
                        <div>@(string.IsNullOrWhiteSpace(alert.SensorDeviceName) ? $"Device {alert.SensorDeviceId}" : alert.SensorDeviceName)</div>
                        <div class="small">@alert.SensorType.ToString(): @FormatReading(alert)</div>
                    </div>
                }
            }
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <h2>Soil Moisture Readings</h2>
            <p>Below is a chart showing the soil moisture readings over time (Higher is Drier).</p>
            <canvas id="soilMoistureChart"></canvas>
        </div>
        <div class="col-md-6">
            <h2>Temperature Readings</h2>
            <p>Below is a chart showing the temperature readings over time.</p>
            <canvas id="temperatureChart"></canvas>
        </div>
        <div class="col-md-6">
            <h2>Battery %</h2>
            <p>Below is a chart showing the battery % over time.</p>
            <canvas id="batteryChart"></canvas>
        </div>
    </div>
</div>

@code {
    private readonly PeriodicTimer _chartRefreshTimer = new(TimeSpan.FromMinutes(15));
    private readonly CancellationTokenSource _chartRefreshCancellation = new();
    private Task? _chartRefreshTask;

    private int _selectedDaysBack = 1;
    private int SelectedDaysBack
    {
        get => _selectedDaysBack;
        set 
        {
            _selectedDaysBack = value;
            _ = RefreshChartsAsync();
        }
    }

    private List<FlatSensorReading> moistureReadings = new();
    private List<FlatSensorReading> temperatureReadings = new();
    private List<FlatSensorReading> batteryReadings = new();
    private List<SensorAlert>? alerts;

    protected override async Task OnInitializedAsync()
    {
        moistureReadings = SensorDataService.GetReadings(1, SensorType.SoilMoisture).ToList();
        temperatureReadings = SensorDataService.GetReadings(1, SensorType.Temperature).ToList();
        batteryReadings = SensorDataService.GetReadings(1, SensorType.Battery).ToList();
        LoadAlerts();
        await Task.CompletedTask;
    }

    private void LoadAlerts()
    {
        alerts = AlertService.GetAlerts();
    }

    private static string FormatReading(SensorAlert alert)
    {
        return alert.SensorType switch
        {
            SensorType.SoilMoisture => $"{alert.LastReading.ValueInt?.ToString() ?? "not reported"} / {alert.LastReading.ValueBool?.ToString() ?? "not reported"} (limit {alert.AlertInt})",
            SensorType.Battery => $"{alert.LastReading.ValueFloat?.ToString() ?? "not reported"}% (minimum {alert.AlertFloat}%)",
            _ => $"{alert.LastReading.ValueFloat?.ToString() ?? "not reported"} (limit {alert.AlertFloat})"
        };
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RefreshChartsAsync();
            _chartRefreshTask = RefreshChartsPeriodicallyAsync();
        }
    }

    private async Task RefreshChartsPeriodicallyAsync()
    {
        try
        {
            while (await _chartRefreshTimer.WaitForNextTickAsync(_chartRefreshCancellation.Token))
            {
                await InvokeAsync(RefreshChartsAsync);
            }
        }
        catch (OperationCanceledException) when (_chartRefreshCancellation.IsCancellationRequested)
        {
        }
    }

    public void Dispose()
    {
        _chartRefreshCancellation.Cancel();
        _chartRefreshTimer.Dispose();
        _chartRefreshCancellation.Dispose();
    }

    private async Task RefreshChartsAsync()
    {
        moistureReadings = SensorDataService.GetReadings(SelectedDaysBack, SensorType.SoilMoisture).ToList();
        temperatureReadings = SensorDataService.GetReadings(SelectedDaysBack, SensorType.Temperature).ToList();
        batteryReadings = SensorDataService.GetReadings(SelectedDaysBack, SensorType.Battery).ToList();
        await ProcessMoistureChartAsync();
        await ProcessTemperatureChartAsync();
        await ProcessBatteryChartAsync();
        LoadAlerts();
    }

    private async Task ProcessMoistureChartAsync()
    {
        var timestampSet = new SortedSet<string>();
        var sensorValues = new Dictionary<string, Dictionary<string, int>>();

        foreach (FlatSensorReading reading in moistureReadings)
        {
            if (!reading.ValueInt.HasValue) continue;

            var timestamp = reading.TimeStamp.ToString("yyyy-MM-dd HH:mm");
            timestampSet.Add(timestamp);

            var key = string.IsNullOrWhiteSpace(reading.SensorDeviceName) ? reading.SourceDeviceId.ToString() : reading.SensorDeviceName;
            if (!sensorValues.TryGetValue(key, out var sensorMap))
            {
                sensorMap = new Dictionary<string, int>();
                sensorValues[key] = sensorMap;
            }

            sensorMap[timestamp] = reading.ValueInt.Value;
        }

        var labels = timestampSet.ToList();
        var datasetMap = sensorValues.ToDictionary(
            kvp => kvp.Key,
            kvp => labels.Select(label => kvp.Value.TryGetValue(label, out var value) ? (int?)value : null).ToList()
        );

        var chartOptions = new
            {
                scales = new
                {
                    y = new
                    {
                        beginAtZero = true,
                        max = 4000,
                        reverse = true
                    }
                }
            };

        await JS.InvokeVoidAsync(
            "chartInterop.renderChart",
            "soilMoistureChart",
            "line",
            labels,
            datasetMap,
            chartOptions
        );
    }

    private async Task ProcessTemperatureChartAsync()
    {
        var timestampSet = new SortedSet<string>();
        var sensorValues = new Dictionary<string, Dictionary<string, float>>();

        foreach (FlatSensorReading reading in temperatureReadings)
        {
            if (!reading.ValueFloat.HasValue) continue;

            var timestamp = reading.TimeStamp.ToString("yyyy-MM-dd HH:mm");
            timestampSet.Add(timestamp);

            var key = string.IsNullOrWhiteSpace(reading.SensorDeviceName) ? reading.SourceDeviceId.ToString() : reading.SensorDeviceName;
            if (!sensorValues.TryGetValue(key, out var sensorMap))
            {
                sensorMap = new Dictionary<string, float>();
                sensorValues[key] = sensorMap;
            }

            sensorMap[timestamp] = reading.ValueFloat.Value;
        }

        var labels = timestampSet.ToList();
        var datasetMap = sensorValues.ToDictionary(
            kvp => kvp.Key,
            kvp => labels.Select(label => kvp.Value.TryGetValue(label, out var value) ? (float?)value : null).ToList()
        );

        var chartOptions = new
            {
                scales = new
                {
                    y = new
                    {
                        min = -5,
                        max = 60
                    }
                }
            };

        await JS.InvokeVoidAsync(
            "chartInterop.renderChart",
            "temperatureChart",
            "line",
            labels,
            datasetMap,
            chartOptions
        );
    }

    private async Task ProcessBatteryChartAsync()
    {
        var timestampSet = new SortedSet<string>();
        var sensorValues = new Dictionary<string, Dictionary<string, float>>();

        foreach (FlatSensorReading reading in batteryReadings)
        {
            if (!reading.ValueFloat.HasValue) continue;

            var timestamp = reading.TimeStamp.ToString("yyyy-MM-dd HH:mm");
            timestampSet.Add(timestamp);

            var key = string.IsNullOrWhiteSpace(reading.SensorDeviceName) ? reading.SourceDeviceId.ToString() : reading.SensorDeviceName;
            if (!sensorValues.TryGetValue(key, out var sensorMap))
            {
                sensorMap = new Dictionary<string, float>();
                sensorValues[key] = sensorMap;
            }

            sensorMap[timestamp] = reading.ValueFloat.Value;
        }

        var labels = timestampSet.ToList();
        var datasetMap = sensorValues.ToDictionary(
            kvp => kvp.Key,
            kvp => labels.Select(label => kvp.Value.TryGetValue(label, out var value) ? (float?)value : null).ToList()
        );

        var chartOptions = new
            {
                scales = new
                {
                    y = new
                    {
                        min = 0,
                        max = 100
                    }
                }
            };

        await JS.InvokeVoidAsync(
            "chartInterop.renderChart",
            "batteryChart",
            "line",
            labels,
            datasetMap,
            chartOptions
        );
    }
}
