<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Info"
      internalLogFile="c:/temp/nlog-internal.log">

  <targets>
    <target xsi:type="File"
            name="file"
            fileName="${basedir}/logs/app.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}"
            archiveFileName="${basedir}/logs/archives/app.{#}.log"
            archiveEvery="Day"
            archiveNumberFormat="000"
            maxArchiveFiles="7" />
    <target xsi:type="File"
            name="samwiseFile"
            fileName="${basedir}/logs/samwise.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:${newline}${exception:format=tostring}}"
            archiveFileName="${basedir}/logs/archives/samwise.{#}.log"
            archiveEvery="Day"
            archiveNumberFormat="000"
            maxArchiveFiles="7" />
  </targets>

  <rules>
    <logger name="*" minlevel="Error" writeTo="file" />
    <logger name="SamwiseBlazor.*" minlevel="Info" writeTo="samwiseFile" />
  </rules>
</nlog>
